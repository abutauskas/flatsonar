# Copy to server/.env. All settings are optional.

# SQLAlchemy URL. Default is a SQLite file next to the server package.
# Postgres example: postgresql+psycopg://flatsea:flatsea@localhost/flatsea
#DATABASE_URL=sqlite:///./flatsea.db

# GitHub personal access token (no scopes needed for public data). Without it the
# GitHub hunter is skipped: code search requires auth and anonymous limits are tiny.
#GITHUB_TOKEN=ghp_...

# Optional tokens raise rate limits on the other forges.
#GITLAB_TOKEN=
#CODEBERG_TOKEN=

# Where HTTP responses are cached between crawls (ETag / If-Modified-Since).
#CRAWL_CACHE_DIR=./.crawl-cache

# Comma-separated list of allowed CORS origins for the API.
#CORS_ORIGINS=http://localhost:3000
